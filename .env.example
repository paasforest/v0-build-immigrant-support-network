# Copy to .env.local for local development. Never commit real values.
# In production, set these in your host's environment variable settings (Vercel or Railway).
# See docs/lead-pipeline.md for the full deployment checklist.

# --- Case storage (required in production) ---------------------------------
# Supabase project: run BOTH migrations in supabase/migrations, in filename order,
# on a staging project first:
#   20261007000000_visa_cases.sql
#   20261011000000_lead_pipeline_admin.sql
# The service-role key is server-only; never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for uploaded documents (created by the first migration).
SUPABASE_CASE_BUCKET=case-documents

# Without Supabase, submissions return 503 and nothing is saved (no fake success).
# For local development/testing only, store cases in ./.data (git-ignored).
# Never use this on a hosted deployment: container disks are wiped on redeploy.
# CASE_STORE=local
# CASE_STORE_DIR=.data

# --- Email (Resend) ----------------------------------------------------------
# Staff alert for each new case (minimal summary + link to the staff dashboard),
# applicant confirmation, and staff sign-in links. Cases are stored even if email
# fails; every outcome is recorded on the case and shown in the dashboard.
# Documents are never emailed. Without these, staff cannot receive sign-in links.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. ISN <notifications@immigrantsupportnetwork.co.za>
NOTIFY_FROM_EMAIL=
# Staff inbox(es) for new-case alerts; comma-separated for several.
CASE_NOTIFY_EMAIL=

# --- Bot protection (Cloudflare Turnstile, recommended) ----------------------
# Both must be set for the check to run: the site key is public (built into the page),
# the secret is server-only. Without them, the honeypot and rate limits still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ----------------------------------------------------------------------
# Public canonical URL (no trailing slash). Used for sitemap, Open Graph, JSON-LD,
# and the links in staff emails (case links and sign-in links).
NEXT_PUBLIC_SITE_URL=https://www.immigrantsupportnetwork.co.za

# Search indexing. ONLY the live production deployment sets SITE_ENV=production;
# without it every page is served noindex (staging, previews, local). Read at build
# time, so a change needs a rebuild. Leave it unset on Railway staging.
# SITE_ENV=production
