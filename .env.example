# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# --- Case storage (required in production) ---------------------------------
# Supabase project: run supabase/migrations/20261007000000_visa_cases.sql first.
# The service-role key is server-only; never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for uploaded documents (created by the migration).
SUPABASE_CASE_BUCKET=case-documents

# Without Supabase, submissions return 503 and nothing is saved (no fake success).
# For local development/testing only, store cases in ./.data (git-ignored):
# CASE_STORE=local
# CASE_STORE_DIR=.data

# --- Email notifications (optional) ------------------------------------------
# Resend API: staff alert for each new case/message and a confirmation to the
# applicant. Cases are stored even if email fails. Documents are never emailed.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
CASE_NOTIFY_EMAIL=

# --- Site ----------------------------------------------------------------------
# Public canonical URL (no trailing slash). Used for sitemap, Open Graph, and JSON-LD.
# Set this in Vercel → Project → Settings → Environment Variables for production.
NEXT_PUBLIC_SITE_URL=https://www.immigrantsupportnetwork.co.za

# Search indexing. ONLY the live production deployment sets SITE_ENV=production;
# without it every page is served noindex (staging, previews, local). Read at build
# time, so a change needs a rebuild. Leave it unset on Railway staging.
# SITE_ENV=production
